# Copy to .env and replace every placeholder before deploying.
DATABASE_URL=postgres://vanthu:change-me@postgres:5432/vanthu
POSTGRES_PASSWORD=change-me
# 32+ random bytes (e.g. `openssl rand -hex 32`); encrypts Dify API key (AES-256-GCM)
APP_SECRET=change-me-32-bytes-hex
# Auth.js session secret
AUTH_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
