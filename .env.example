# ============================================================================
# Van Thu Portal - cấu hình triển khai. Sao chép thành .env rồi thay MỌI giá trị "change-me":
#     cp .env.example .env && chmod 600 .env
# KHÔNG commit .env, KHÔNG dán nội dung .env vào chat/ticket. Hướng dẫn đầy đủ: docs/deploy.md
# Mẹo: dùng chuỗi hex (openssl rand -hex ...) cho mật khẩu/bí mật để tránh ký tự đặc biệt
# (Docker Compose diễn giải ký tự "$" trong .env).
# ============================================================================

# --- Cơ sở dữ liệu -----------------------------------------------------------
# Mật khẩu của Postgres trong Docker (người dùng "vanthu", database "vanthu").
# Tạo bằng:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Chuỗi kết nối cho web/worker/migrate. Host PHẢI là "postgres" (tên service Compose) và mật khẩu (giữa
# "vanthu:" và "@postgres") PHẢI trùng POSTGRES_PASSWORD ở trên.
DATABASE_URL=postgres://vanthu:change-me@postgres:5432/vanthu

# --- Bí mật ứng dụng ---------------------------------------------------------
# Khóa mã hóa API key Dify lưu trong DB (AES-256-GCM). Tối thiểu 32 ký tự. Tạo bằng:  openssl rand -hex 32
# CẢNH BÁO: đổi/mất giá trị này thì các API key Dify đã lưu KHÔNG giải mã được (phải nhập lại ở Quản trị > Tích hợp).
# Hãy lưu bản sao ở nơi an toàn, tách khỏi bản sao lưu dữ liệu.
APP_SECRET=change-me
# Khóa ký phiên đăng nhập (Auth.js). Tạo bằng:  openssl rand -hex 32
# Đổi giá trị này = mọi người bị đăng xuất, không mất dữ liệu.
AUTH_SECRET=change-me

# --- Địa chỉ công khai (QUAN TRỌNG) -----------------------------------------
# URL mà người dùng gõ vào trình duyệt. Ở chế độ production, cookie phiên được gắn cờ Secure TRỪ KHI AUTH_URL
# bắt đầu bằng http://. Nếu để sai (ví dụ để https:// trong khi truy cập qua HTTP thuần) trình duyệt sẽ vứt
# cookie và đăng nhập luôn quay về trang /login.
#  - Chạy HTTP thuần theo IP:   AUTH_URL=http://<IP-máy-chủ>:8080
#  - Đã bật HTTPS (Caddyfile):  AUTH_URL=https://portal.example.vn
# Mặc định dưới đây chỉ đúng khi mở trình duyệt TRÊN CHÍNH máy chủ; hãy sửa trước khi đưa cho người dùng.
# (Không cần AUTH_TRUST_HOST: mã nguồn đã đặt trustHost=true để chạy sau Caddy, xem src/auth/config.ts.)
AUTH_URL=http://localhost:8080

# --- Tài khoản quản trị đầu tiên --------------------------------------------
# Chỉ dùng ở lần seed đầu tiên: container "migrate" tạo Ban thư ký và admin nếu admin chưa tồn tại. Với tài khoản
# đã có, giá trị ADMIN_PASSWORD KHÔNG còn tác dụng (không ghi đè mật khẩu). Sau khi đăng nhập hãy đổi mật khẩu trong
# giao diện (Quản trị > Người dùng). Compose vẫn đòi biến này mỗi lần chạy, nên cứ để một giá trị hợp lệ.
# Tên đăng nhập 3-50 ký tự, mật khẩu 8-256 ký tự.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Lưu trữ -----------------------------------------------------------------
# Thư mục lưu PDF tải lên (<DATA_DIR>/pdf) và kết quả OCR (<DATA_DIR>/md). Trong Docker giữ nguyên /data:
# web và worker dùng chung volume "appdata" gắn vào đó.
DATA_DIR=/data

# --- Nối mạng với Dify (chỉ khi dùng docker-compose.dify.yml) ---------------
# Tên mạng Docker của Dify đang chạy trên máy này. Tìm bằng:  docker network ls
# (với Dify cài theo hướng dẫn mặc định, thư mục "docker", tên thường là "docker_default").
# Xác nhận bằng:  docker network inspect <tên>  (xem có container nginx/api của Dify).
#DIFY_NETWORK=docker_default
# Nơi cổng "dify-gateway" chuyển tiếp tới: <tên service nginx của Dify>:<cổng trong container>. Mặc định nginx:80.
# Kiểm tra bằng:  docker ps --format '{{.Names}}'  rồi  docker network inspect <DIFY_NETWORK>
#DIFY_UPSTREAM=nginx:80
# Để bật override mà không cần gõ -f mỗi lần (dấu ":" ngăn cách file):
#COMPOSE_FILE=docker-compose.yml:docker-compose.dify.yml
# Base URL nhập ở Quản trị > Tích hợp khi dùng override:  http://dify-gateway/v1
# Phương án khác (không nối mạng, đi qua cổng Dify công bố trên máy chủ): http://host.docker.internal:80/v1,
# xem docs/deploy.md mục 5.

# --- Biến chỉ dành cho phát triển/kiểm thử (KHÔNG đặt khi triển khai) -------
# SSE_REVALIDATE_MS: rút ngắn chu kỳ kiểm tra lại phiên của luồng SSE khi dev/test; bị bỏ qua ở production.
# NODE_ENV, PORT, HOSTNAME: do Dockerfile đặt (production, 3000, 0.0.0.0).
# MIGRATIONS_DIR: thư mục drizzle/ cho dist/migrate.js; mặc định /app/drizzle trong image, không cần đặt.
