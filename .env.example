# Copy to .env and replace every placeholder before deploying.
DATABASE_URL=postgres://vanthu:change-me@postgres:5432/vanthu
POSTGRES_PASSWORD=change-me
# Must be >= 32 chars (generate with `openssl rand -hex 32`); encrypts the Dify API key (AES-256-GCM).
# WARNING: changing it later makes the stored Dify API keys undecryptable (re-enter them in Admin > Integrations).
APP_SECRET=change-me-32-bytes-hex
# Auth.js session secret
AUTH_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
